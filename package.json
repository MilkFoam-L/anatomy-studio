{
  "name": "anatomy-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A static web studio that runs the Anatomy skill in your browser with your own Claude API key and endpoint.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bundle:skill": "node scripts/bundle-skill.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "predev": "npm run bundle:skill && npm run build:runtime",
    "dev": "vite",
    "prebuild": "npm run bundle:skill && npm run build:runtime",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "modern-screenshot": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
